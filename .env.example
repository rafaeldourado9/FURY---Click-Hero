# Ambiente
NODE_ENV=development
PORT=3000

# Logs (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Limite de body para o webhook (em bytes)
BODY_LIMIT_BYTES=65536

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # opcional — defina em produção

# Integração externa (simulada via JSONPlaceholder)
EXTERNAL_TAKEDOWN_URL=https://jsonplaceholder.typicode.com/posts/1
HTTP_TIMEOUT_MS=5000
